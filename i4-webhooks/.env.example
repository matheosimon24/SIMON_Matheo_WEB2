# Variables d'environnement reconnues par le module I4 (valeurs de développement local uniquement).
# Elles ne sont pas chargées automatiquement : les définir dans le terminal avant de lancer uvicorn,
# par exemple sous PowerShell :  $env:PARTENAIRE_MODE="flaky"

# Secret HMAC partagé avec l'émetteur des webhooks (secret local imposé par le sujet).
MATRICE_WEBHOOK_SECRET=matrice-local-only

# Adresse du partenaire appelée par le récepteur.
PARTENAIRE_URL=http://127.0.0.1:8001/tickets

# Mode du partenaire simulé : ok, flaky, down, slow ou reject.
PARTENAIRE_MODE=ok
